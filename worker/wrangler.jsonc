// Deploy: worker/deploy.sh on the server (Wrangler in a throwaway container; the token stays in ~/site-deploy.env).
{
  "name": "fragrancenotes",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    // Only these paths run the Worker code (the database pages from the API); everything else is a site file.
    "run_worker_first": ["/database", "/database/*", "/perfume/*", "/note/*", "/photo/*", "/assets/*", "/sitemap.xml"]
  },
  "routes": [{ "pattern": "fragrancenotes.app", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": false }
}
